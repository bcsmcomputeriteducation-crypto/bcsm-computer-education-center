rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function emailIs(value) { return signedIn() && request.auth.token.get('email', '') == value; }
    function roleIs(role) {
      return signedIn() && (
        request.auth.token.get('role', '') == role ||
        (role == 'admin' && emailIs('bcsmcomputer.iteducation+admin@gmail.com')) ||
        (role == 'instituteAdmin' && emailIs('bcsmcomputer.iteducation+institute@gmail.com')) ||
        (role == 'teacher' && emailIs('bcsmcomputer.iteducation+teacher@gmail.com'))
      );
    }
    function isAdmin() { return roleIs('admin'); }
    function canManageInstitute() { return isAdmin() || roleIs('instituteAdmin'); }

    match /appData/{docId} { allow read, write: if canManageInstitute(); }
    match /roleCredentials/{id} { allow read, write: if false; }
    match /rolePasswordResets/{id} { allow read, write: if false; }
    match /roleAuthRateLimits/{id} { allow read, write: if false; }

    match /students/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'student';
      allow read: if (signedIn() && request.auth.uid == uid) || canManageInstitute() || roleIs('teacher');
      allow update: if canManageInstitute() || roleIs('teacher') ||
        (signedIn() && request.auth.uid == uid && request.resource.data.uid == uid &&
         request.resource.data.role == resource.data.role && resource.data.role == 'student');
      allow delete: if canManageInstitute();
    }
    match /admins/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /teachers/{id} { allow read: if canManageInstitute() || roleIs('teacher'); allow write: if canManageInstitute(); }
    match /courses/{id} { allow read: if true; allow write: if canManageInstitute(); }
    match /admissions/{id} { allow read, create, update: if canManageInstitute() || roleIs('teacher'); allow delete: if canManageInstitute(); }
    match /results/{id} {
      allow read: if canManageInstitute() || roleIs('teacher') || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create, update, delete: if canManageInstitute();
    }
    match /monthlyExamRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.status == 'pending' && request.resource.data.studentName is string &&
        request.resource.data.courseName is string && request.resource.data.courseId is string &&
        request.resource.data.courseKey is string && request.resource.data.semester is string &&
        request.resource.data.batch is string && request.resource.data.requestToken is string;
      allow read: if canManageInstitute() || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow update: if canManageInstitute() && request.resource.data.status in ['approved', 'denied'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedAt', 'approvedBy']);
      allow delete: if canManageInstitute();
    }
    match /monthlyExamSettings/{courseKey} {
      allow read: if signedIn();
      allow create, update: if canManageInstitute() && request.resource.data.courseKey == courseKey &&
        request.resource.data.type == 'Monthly Main Exam' && request.resource.data.published == true &&
        request.resource.data.questionCount is number && request.resource.data.duration is number &&
        request.resource.data.totalMarks is number && request.resource.data.passMarks is number;
      allow delete: if canManageInstitute();
    }
    match /monthlyExamResults/{resultId} {
      allow create: if signedIn() && request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.id == resultId && request.resource.data.score is number &&
        request.resource.data.maxScore is number && request.resource.data.examId is string;
      allow read: if canManageInstitute() || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow update, delete: if canManageInstitute();
    }
    match /examQuestions/{id} { allow read: if signedIn(); allow write: if canManageInstitute(); }
    match /monthlyExams/{id} { allow read: if signedIn(); allow write: if canManageInstitute(); }
    match /examCloudConfig/{id} { allow read: if signedIn(); allow write: if canManageInstitute(); }
    match /{document=**} { allow read, write: if false; }
  }
}
