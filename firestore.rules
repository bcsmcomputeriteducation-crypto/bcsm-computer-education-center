rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMainAdmin() { return signedIn() && request.auth.token.email == 'bcsmcomputer.iteducation+admin@gmail.com'; }
    match /monthlyExamRequests/{requestId} {
      allow create: if request.resource.data.keys().hasAll(['studentName','courseId','courseName','semester','batch','examType','status','requestedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.examType == 'Monthly Main Exam'
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.batch in ['7 TO 9','9 TO 11','11 TO 01','01 TO 03','03 TO 05'];
      allow get: if isMainAdmin() || resource.data.requestToken == requestId;
      allow list: if isMainAdmin();
      allow update: if isMainAdmin() && request.resource.data.status in ['approved','denied']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','approvedAt','approvedBy']);
      allow delete: if isMainAdmin();
    }
    match /monthlyExamSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isMainAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
