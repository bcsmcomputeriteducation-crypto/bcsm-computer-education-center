rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMainAdmin() {
      return signedIn() && (
        request.auth.token.email == 'bcsmcomputer.iteducation+admin@gmail.com' ||
        request.auth.token.role == 'admin'
      );
    }
    match /examQuestions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isMainAdmin();
    }
    match /monthlyExams/{examId} {
      allow read: if true;
      allow create, update, delete: if isMainAdmin();
    }
    match /examCloudConfig/{configId} {
      allow read: if configId == 'monthly';
      allow create, update, delete: if isMainAdmin();
    }
    match /monthlyExamRequests/{requestId} {
      allow create: if isMainAdmin() || (signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.id == requestId);
      allow read: if isMainAdmin() || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow update: if isMainAdmin();
      allow delete: if isMainAdmin();
    }
    match /monthlyExamResults/{resultId} {
      allow read: if isMainAdmin() || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create: if isMainAdmin() || (signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.id == resultId
        && (
          request.resource.data.type == 'Monthly Practice Exam' ||
          (request.resource.data.type == 'Monthly Main Exam'
            && request.resource.data.requestId is string
            && get(/databases/$(database)/documents/monthlyExamRequests/$(request.resource.data.requestId)).data.studentUid == request.auth.uid
            && get(/databases/$(database)/documents/monthlyExamRequests/$(request.resource.data.requestId)).data.status == 'approved')
        ));
      allow update, delete: if isMainAdmin();
    }
    // Preserve the existing website's role and student rules.
    function roleIs(role) {
      return signedIn() && (
        (role == 'admin' && request.auth.token.email == 'bcsmcomputer.iteducation+admin@gmail.com') ||
        (role == 'instituteAdmin' && request.auth.token.email == 'bcsmcomputer.iteducation+institute@gmail.com') ||
        (role == 'teacher' && request.auth.token.email == 'bcsmcomputer.iteducation+teacher@gmail.com')
      );
    }
    function canManageInstitute() { return roleIs('admin') || roleIs('instituteAdmin'); }
    match /roleCredentials/{role} { allow read, write: if false; }
    match /rolePasswordResets/{token} { allow read, write: if false; }
    match /students/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'student';
      allow read: if (signedIn() && request.auth.uid == uid) || canManageInstitute() || roleIs('teacher');
      allow update: if (signedIn() && request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.role == 'student') || canManageInstitute() || roleIs('teacher');
      allow delete: if canManageInstitute();
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /teachers/{id} { allow read: if canManageInstitute() || roleIs('teacher'); allow write: if canManageInstitute(); }
    match /courses/{id} { allow read: if true; allow write: if canManageInstitute(); }
    match /admissions/{id} { allow read, create, update: if canManageInstitute() || roleIs('teacher'); allow delete: if canManageInstitute(); }
    match /results/{id} {
      allow read: if canManageInstitute() || roleIs('teacher') || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create, update, delete: if canManageInstitute();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
